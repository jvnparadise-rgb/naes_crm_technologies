n).join(' ').trim()\n          || backendRecord.primary_contact_name\n          || '',\n      };\n    } catch (error) {\n      console.warn('Could not save opportunity patch to backend, using local fallback', error);\n    }\n\n    setOpportunities((prev) =>\n      prev.map((item) =>\n        item.id === opportunityId\n          ? nextRecord\n          : item\n      )\n    );\n  }\n\n    function deleteOpportunityLocal(opportunityId) {\n      setOpportunities((prev) => prev.filter((item) => item.id !== opportunityId));\n    }\n\n  function goBack() {\n    setPageHistory((prev) => {\n      if (prev.length <= 1) return prev;\n      const next = prev.slice(0, -1);\n      setActivePage(next[next.length - 1] || 'Welcome');\n      return next;\n    });\n  }\n\n  const canGoBack = pageHistory.length > 1;\n\n  if (!authChecked && cognitoCallbackStatus === 'idle') {\n    return null;\n  }\n\n  if (cognitoCallbackStatus === 'loading') {\n    return (\n      <div style={{ minHeight: '100vh', display: 'grid', placeItems: 'center', background: '#f5f7fb', color: '#123B42', fontFamily: 'Arial, sans-serif' }}>\n        <div style={{ fontSize: '18px', fontWeight: 700 }}>Signing you in...</div>\n      </div>\n    );\n  }\n\n  if (cognitoCallbackStatus === 'error') {\n    return (\n      <div style={{ minHeight: '100vh', display: 'grid', placeItems: 'center', background: '#f5f7fb', color: '#123B42', fontFamily: 'Arial, sans-serif', padding: '24px' }}>\n        <div style={{ maxWidth: '640px', textAlign: 'center' }}>\n          <div style={{ fontSize: '22px', fontWeight: 800, marginBottom: '12px' }}>Sign-in could not be completed</div>\n          <div style={{ fontSize: '14px', lineHeight: 1.6, color: '#5F6F72' }}>\n            The CRM received the Cognito callback but could not finish session setup. Refresh once and try again.\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n\n  return (\n    <div style={{ minHeight: '100vh', height: '100vh', overflow: 'hidden', backgrou