                  {[\n                            ['Company / Keyword', 'solar, logistics, rooftop...'],\n                            ['Industry', 'Renewables, Logistics...'],\n                            ['HQ Region', 'AZ, TX, CA, NV...'],\n                            ['Employee Count', '250+'],\n                            ['Revenue Range', '$100M+'],\n                            ['Technology / Asset Signal', 'PV, rooftop, cold storage...']\n                          ].map(([label, placeholder]) => (\n                            <label key={label} style={{ display: 'grid', gap: '6px', marginBottom: '12px', color: '#445f54', fontSize: '12px', fontWeight: 850 }}>\n                              {label}\n                              <input disabled placeholder={placeholder} style={{ border: '1px solid #d7e4d8', borderRadius: '12px', padding: '10px 12px', background: '#f8fafc', color: '#64748b' }} />\n                            </label>\n                          ))}\n\n                          <div style={{ border: '1px solid #e0f2fe', background: '#f0f9ff', color: '#075985', borderRadius: '14px', padding: '12px', fontSize: '12px', fontWeight: 800, lineHeight: 1.45 }}>\n                            API mode will run through CRM backend only. No Apollo credentials will be exposed in the browser.\n                          </div>\n                        </div>\n\n                        <div style={{ border: '1px solid #d7e4d8', borderRadius: '22px', background: '#ffffff', padding: '16px', boxShadow: '0 14px 32px rgba(16,24,40,0.05)' }}>\n                          <div style={{ display: 'flex', justifyContent: 'space-between', gap: '12px', alignItems: 'center', marginBottom: '14px' }}>\n                            <div>\n                              <div style={{ fontSize: '10px', fontWeight: 900, letterSpacing: '0.18em', textTransform: 'uppercase', color: '#6b7f76' }}>Apollo Search</div>\n                              <h3 style={{ margin: '6px 0 0', color: '#111827