2px', fontWeight: 800, marginBottom: '12px' }}>\n                              {apolloSearchError}\n                            </div>\n                          ) : null}\n\n                          <div style={{ display: 'grid', gap: '12px' }}>\n                            {activeApolloRecords.map((record) => (\n                              <div key={record.company} style={{ border: '1px solid #e3ece4', borderRadius: '18px', padding: '14px', background: '#ffffff' }}>\n                                <div style={{ display: 'flex', justifyContent: 'space-between', gap: '12px', alignItems: 'flex-start' }}>\n                                  <div>\n                                    <strong style={{ color: '#111827', fontSize: '15px' }}>{record.company}</strong>\n                                    <div style={{ marginTop: '4px', color: '#64748b', fontSize: '12px' }}>{record.industry} · {record.hq} · {record.employees} employees · {record.revenue}</div>\n                                  </div>\n                                  <span style={{ border: '1px solid #bae6fd', background: '#f0f9ff', color: '#075985', borderRadius: '999px', padding: '5px 9px', fontSize: '11px', fontWeight: 900 }}>{record.confidence}</span>\n                                </div>\n\n                                <p style={{ margin: '10px 0 0', color: '#334155', fontSize: '13px', lineHeight: 1.45 }}>{record.buyingSignal}</p>\n\n                                <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', marginTop: '12px' }}>\n                                  <span style={{ border: '1px solid #d7e4d8', background: '#f8fbf8', color: '#315348', borderRadius: '999px', padding: '5px 9px', fontSize: '11px', fontWeight: 850 }}>Fit: {record.serviceFit}</span>\n                                  <span style={{ border: '1px solid #d7e4d8', background: '#f8fbf8', color: '#315348', borderRadius: '999px', padding: '5px 9px', fontSize: '11px', fontWeight: 850 }}>{record.contacts} contacts</span>\n                                  <span style={{ border: '1px solid #d7e4d8', background: '#f8fbf8', color: '#315348', borderRadius: '999px', padding: '5px 9px', fontSize: '11px', fontWeight: 850 }}>Potential: {record.estimatedRevenue}</span>\n                                </div>\n\n                                  <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, minmax(0, 1fr))', gap: '10px', marginTop: '14px' }}>\n                                    <button\n                                      type="button"\n                                      onClick={() => {\n                                          const prospect = {\n                                            name: record.company,\n                                            company: record.company,\n                                            industry: record.industry,\n                                            businessType: record.industry,\n                                            region: record.hq,\n                                            hq: record.hq,\n                                            serviceFit: [record.serviceFit].filter(Boolean),\n                                            marketSegment: record.serviceFit,\n                                            signalInsight: record.buyingSignal,\n                                            buyingSignal: record.buyingSignal,\n                                            estimatedRevenue: record.estimatedRevenue,\n                                            employees: record.employees,\n                                            contacts: record.contacts,\n                                            confidence: record.confidence,\n                                            sourceStatus: record.sourceStatus,\n                                            source: 'Apollo Search'\n                                          };\n                                        seedSignalAccountIntake(prospect);\n                                      }}\n                                      style={{ border: '1px solid #b9d8c4', background: '#eaf5ee', color: '#153d2f', borderRadius: '12px', padding: '12px 10px', fontSize: '12px', fontWeight: 900, cursor: 'pointer' }}\n                                    >\n                                      Account Intelligence\n                                    </button>\n\n                                    <button\n                                      type="button"\n                                      onClick={() => {\n                                        const prospect = {\n                                          name: record.company,\n                                          company: record.company,\n                                          industry: record.industry,\n                                          region: record.hq,\n                                          serviceFit: [record.serviceFit],\n                                          signalInsight: record.buyingSignal,\n                                          estimatedRevenue: record.estimatedRevenue\n                                        };\n                                        seedSignalContactIntake(prospect);\n                                      }}\n                                      style={{ border: '1px solid #b7dde5', background: '#eef9fb', color: '#0B6771', borderRadius: '12px', padding: '12px 10px', fontSize: '12px', fontWeight: 900, cursor: 'pointer' }}\n                                    >\n                                      Contacts\n                                    </button>\n\n                                    <button\n                                      type="button"\n                                      onClick={() => {\n                                        const prospect = {\n                                          name: record.company,\n                                          company: record.company,\n                                          industry: record.industry,\n                                          region: record.hq,\n                                          serviceFit: [record.serviceFit],\n                                          signalInsight: record.buyingSignal,\n                                          estimatedRevenue: record.estimatedRevenue\n                                        };\n                                        seedSignalDealIntake(prospect);\n                                      }}\n                                      style={{ border: '1px solid #b9d8f0', background: '#eef6ff', color: '#1476b8', borderRadius: '12px', padding: '12px 10px', fontSize: '12px', fontWeight: 900, cursor: 'pointer' }}\n                                    >\n                                      New Deal\n                                    </button>\n                                  </div>\n                              </div>\n                            ))}\n                          </div>\n                        </div>\n\n                        <div style={{ border: '1px solid #d7e4d8', borderRadius: '22px', background: '#ffffff', padding: '16px', boxShadow: '0 14px 32px rgba(16,24,40,0.05)' }}>\n                          <div style={{ fontSize: '10px', fontWeight: 900, letterSpacing: '0.18em', textTransform: 'uppercase', color: '#6b7f76' }}>Selected Record Preview</div>\n                          <h3 style={{ margin: '6px 0 14px', color: '#111827' }}>Enrichment Pipeline</h3>\n\n                          {[\n                            ['1', 'Search', 'Find companies and candidate contacts.'],\n                            ['2', 'Enrich', 'Pull company/contact details server-side.'],\n                            ['3', 'Normalize', 'Map Apollo result into Signal prospect schema.'],\n                            ['4', 'Score', 'Apply Signal scoring and revenue model.'],\n                            ['5', 'Queue', 'Send to controlled CRM intake queue.']\n                          ].map(([step, title, body]) => (\n                            <div key={step} style={{ display: 'grid', gridTemplateColumns: '30px minmax(0, 1fr)', gap: '10px', borderTop: '1px solid #edf2ee', padding: '12px 0' }}>\n                              <div style={{ width: '28px', height: '28px', borderRadius: '999px', background: '#0B6771', color: '#fff', display: 'grid', placeItems: 'center', fontSize: '12px', fontWeight: 900 }}>{step}</div>\n                              <div>\n                                <strong style={{ color: '#111827', fontSize: '13px' }}>{title}</strong>\n                                <div style={{ color: '#64748b', fontSize: '12px', marginTop: '3px', lineHeight: 1.4 }}>{body}</div>\n                              </div>\n                            </div>\n                          ))}\n\n                          <div style={{ marginTop: '14px', border: '1px dashed #9fb9ad', borderRadius: '16px', padding: '14px', background: '#f8fbf8', color: '#315348', fontSize: '12px', fontWeight: 800, lineHeight: 1.45 }}>\n                            Next backend endpoint: /api/signal/apollo/search. Credentials stay on server or AWS Secrets Manager.\n                          </div>\n                        </div>\n                      </div>\n                    ) : signalOutreachTab === 'Find New Customers' ? (\n                      <div style={{ border: '1px solid #d7e4d8', borderRadius: '22px', background: '#fff', padding: '20px' }}>\n                        <div style={{ fontSize: '10px', fontWeight: 900, letterSpacing: '0.18em', textTransform: 'uppercase', color: '#6b7f76' }}>Discovery Workspace</div>\n                        <h3 style={{ margin: '6px 0 12px', color: '#111827' }}>Find New Customers</h3>\n                        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, minmax(160px, 1fr))', gap: '12px' }}>\n                          {['Industry', 'Region', 'Service Fit', 'Minimum Score'].map((label) => (\n                            <label key={label} style={{ display: 'grid', gap: '6px', color: '#445f54', fontSize: '12px', fontWeight: 800 }}>\n                              {label}\n                              <input disabled placeholder="Coming next" style={{ border: '1px solid #d7e4d8', borderRadius: '12px', padding: '10px', background: '#f8fafc' }} />\n                            </label>\n                          ))}\n                        </div>\n                        <p style={{ margin: '14px 0 0', color: '#5e786d' }}>\n                          This tab will become the prospect search and scoring workbench. For now, it is intentionally disabled so no production data is touched.\n                        </p>\n                      </div>\n                    ) : signalOutreachTab === 'Prospect Lists' ? (\n                      <div style={{ border: '1px solid #d7e4d8', borderRadius: '22px', background: '#fff', padding: '20px' }}>\n                        <div style={{ fontSize: '10px', fontWeight: 900, letterSpacing: '0.18em', textTransform: 'uppercase', color: '#6b7f76' }}>List Management</div>\n                        <h3 style={{ margin: '6px 0 12px', color: '#111827' }}>Prospect Lists</h3>\n                        {['Strategic Rooftop Targets', 'Renewables Expansion Targets', 'Industrial O&M Prospects'].map((list, idx) => (\n                          <div key={list} style={{ display: 'flex', justifyContent: 'space-between', gap: '12px', alignItems: 'center', borderTop: idx ? '1px solid #edf2ee' : '0', padding: '13px 0' }}>\n                            <div>\n                              <strong style={{ color: '#111827' }}>{list}</strong>\n                              <div style={{ color: '#64748b', fontSize: '13px', marginTop: '3px' }}>Sample list, UI only</div>\n                            </div>\n                            <span style={{ border: '1px solid #d7e4d8', borderRadius: '999px', padding: '5px 10px', color: '#445f54', fontWeight: 800, fontSize: '12px' }}>{idx + 3} accounts</span>\n                          </div>\n                        ))}\n                      </div>\n                    \n                      ) : signalOutreachTab === 'Campaigns' ? (\n                        <div style={{ border: '1px solid #d7e4d8', borderRadius: '22px', background: '#fff', padding: '20px' }}>\n                          <div style={{ display: 'flex', justifyContent: 'space-between', gap: '12px', alignItems: 'flex-start', marginBottom: '14px' }}>\n                            <div>\n                              <div style={{ fontSize: '10px', fontWeight: 900, letterSpacing: '0.18em', textTransform: 'uppercase', color: '#6b7f76' }}>Campaign Service</div>\n                              <h3 style={{ margin: '6px 0 4px', color: '#111827' }}>Signal Campaigns</h3>\n                              <p style={{ margin: 0, color: '#5e786d' }}>\n                                Campaigns are live. Safe Mode allows full send simulation with tracking and event logging. Live Mode unlocks once deliverability (SPF/DKIM/DMARC) is verified.\n                              </p>\n                            </div>\n                            <button\n                              type="button"\n                              onClick={loadSignalCampaigns}\n                              style={{ border: '1px solid #0B6771', background: '#0B6771', color: '#fff', borderRadius: '999px', padding: '8px 12px', fontSize: '12px', fontWeight: 850, cursor: 'pointer' }}\n                            >\n                              Refresh\n                            </button>\n                          </div>\n\n                          <div style={{ marginBottom: '16px', border: '1px solid #d7e4d8', borderRadius: '16px', padding: '16px', background: '#f8fbf8' }}>\n                            <div style={{ fontWeight: 900, marginBottom: '10px', color: '#111827' }}>Template Engine</div>\n                            <input\n                              value={campaignSubject}\n                              onChange={(e) => setCampaignSubject(e.target.value)}\n                              placeholder="Subject"\n                              style={{ width: '100%', padding: '10px', borderRadius: '10px', border: '1px solid #d7e4d8', marginBottom: '10px' }}\n                            />\n                            <textarea\n                              value={campaignBody}\n                              onChange={(e) => setCampaignBody(e.target.value)}\n                              rows={6}\n                              style={{ width: '100%', padding: '10px', borderRadius: '10px', border: '1px solid #d7e4d8' }}\n                            />\n                            <div style={{ marginTop: '10px', color: '#64748b', fontSize: '12px', fontWeight: 800 }}>\n                              Variables: {'{{first_name}}'} {'{{company}}'} {'{{service_fit}}'} {'{{signal_insight}}'}\n                            </div>\n                          </div>\n\n                          <div style={{ marginBottom: '16px', border: '1px solid #d7e4d8', borderRadius: '16px', background: '#f8fbf8', padding: '14px' }}>\n                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: '12px', alignItems: 'flex-start', marginBottom: '12px' }}>\n                              <div>\n                                <div style={{ color: '#123B42', fontSize: '12px', fontWeight: 900, letterSpacing: '0.08em', textTransform: 'uppercase' }}>Send Readiness</div>\n                                <button\n                                  type="button"\n                                  onClick={loadSignalReadiness}\n                                  style={{\n                                    marginLeft: '8px',\n                                    border: '1px solid #d7e4d8',\n                                    background: '#ffffff',\n                                    color: '#315348',\n                                    borderRadius: '999px',\n                                    padding: '4px 8px',\n                                    fontSize: '10px',\n                                    fontWeight: 900,\n                                    cursor: 'pointer'\n                                  }}\n                                >\n                                  Refresh\n                                </button>\n                                <div style={{ color: '#5e786d', fontSize: '12px', marginTop: '4px' }}>\n                                  Live sending remains locked until deliverability controls are verified.\n                                </div>\n                              </div>\n                              <span style={{\n                                border: '1px solid #fed7aa',\n                                background: '#fff7ed',\n                                color: '#9a3412',\n                                borderRadius: '999px',\n                                padding: '5px 10px',\n                                fontSize: '11px',\n                                fontWeight: 900,\n                                whiteSpace: 'nowrap'\n                              }}>\n                                {signalReadiness.live_ready ? 'Live Ready' : 'Safe Mode'}\n                              \n                              </span>\n                            </div>\n\n                            <div style={{ display: 'flex', gap: '8px', alignItems: 'center', flexWrap: 'wrap', marginBottom: '12px' }}>\n                              {[\n                                ['safe', 'Safe Mode'],\n                                ['live', 'Live Mode']\n                              ].map(([mode, label]) => {\n                                const active = signalSendMode === mode;\n                                const locked = mode === 'live' && !signalReadiness.live_ready;\n                                return (\n                                  <button\n                                    key={mode}\n                                    type="button"\n                                    disabled={locked}\n                                    onClick={() => setSignalSendMode(mode)}\n                                    title={locked ? 'Live mode is locked until all readiness checks pass.' : label}\n                                    style={{\n                                      border: active ? '1px solid #0B6771' : '1px solid #d7e4d8',\n                                      background: active ? '#0B6771' : '#ffffff',\n                                      color: locked ? '#94a3b8' : (active ? '#ffffff' : '#315348'),\n                                      borderRadius: '999px',\n                                      padding: '7px 11px',\n                                      fontSize: '11px',\n                                      fontWeight: 900,\n                                      cursor: locked ? 'not-allowed' : 'pointer',\n                                      opacity: locked ? 0.65 : 1\n                                    }}\n                                  >\n                                    {label}{locked ? ' Locked' : ''}\n                                  </button>\n                                );\n                              })}\n                              <span style={{ color: '#64748b', fontSize: '11px', fontWeight: 800 }}>\n                                Selected send mode: {signalSendMode === 'live' ? 'Live' : 'Safe'}\n                              </span>\n                            </div>\n\n                            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, minmax(0, 1fr))', gap: '10px' }}>\n                              {(signalReadiness.checks || []).map((check) => (\n                                <div key={check.key || check.label} title={check.detail} style={{ border: '1px solid #d7e4d8', borderRadius: '14px', background: '#ffffff', padding: '12px' }}>\n                                  <div style={{ display: 'flex', alignItems: 'center', gap: '7px', marginBottom: '6px' }}>\n                                    <span style={{\n                                      width: '9px',\n                                      height: '9px',\n                                      borderRadius: '999px',\n                                      background: check.ready\n                                      ? '#0B6771'\n                                      : (check.key === 'live_send' ? '#991b1b' : '#d97706'),\n                                      display: 'inline-block'\n                                    }} />\n                                    <strong style={{ color: '#111827', fontSize: '12px' }}>{check.label}</strong>\n                                  </div>\n                                  <div style={{ color: '#64748b', fontSize: '11px', lineHeight: 1.4 }}>{check.detail}</div>\n                                </div>\n                              ))}\n                            </div>\n                          </div>\n\n                          {signalCampaigns.length === 0 ? (\n                            <div style={{ border: '1px dashed #9fb9ad', borderRadius: '18px', background: '#f8fbf8', padding: '28px', textAlign: 'center', color: '#445f54', fontWeight: 800 }}>\n                              No campaigns yet. Create one from the Intake Queue.\n                            </div>\n                          ) : (\n                            <div style={{ display: 'grid', gap: '12px' }}>\n                              {signalCampaigns.map((campaign) => (\n                                <div key={campaign.id} style={{ border: '1px solid #d7e4d8', borderRadius: '18px', padding: '16px', background: '#ffffff' }}>\n                                  <div style={{ display: 'flex', justifyContent: 'space-between', gap: '12px', alignItems: 'flex-start' }}>\n                                    <div>\n                                      <strong style={{ color: '#111827', fontSize: '16px' }}>{campaign.name}</strong>\n                                      <div style={{ marginTop: '4px', color: '#64748b', fontSize: '12px' }}>\n                                        {campaign.segment || 'General'} · {campaign.status || 'draft'} · {(campaign.contacts || []).length} contacts\n                                      </div>\n                                    </div>\n                                    <div style={{ display: 'flex', gap: '8px', alignItems: 'center', flexWrap: 'wrap', justifyContent: 'flex-end' }}>\n                                      <span style={{ border: '1px solid #fed7aa', background: '#fff7ed', color: '#9a3412', borderRadius: '999px', padding: '5px 9px', fontSize: '11px', fontWeight: 900 }}>\n                                        Safe Mode Active\n                                      </span>\n                                      <button\n                                        type="button"\n                                        onClick={() => runSignalSendPreview(campaign.id)}\n                                        style={{ border: '1px solid #0B6771', background: '#0B6771', color: '#fff', borderRadius: '999px', padding: '6px 10px', fontSize: '11px', fontWeight: 900, cursor: 'pointer' }}\n                                      >\n                                        Preview Send <span title="Preview Send renders the final personalized email payload, including subject, body, open pixel, and tracked links. It does not create a send event and does not send email." style={{ marginLeft: '6px', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: '14px', height: '14px', borderRadius: '999px', background: 'rgba(255,255,255,0.18)', fontSize: '10px', fontWeight: 900 }}>i</span>\n                                      </button>\n                                      <button\n                                        type="button"\n                                        onClick={() => runSignalSimulatedSend(campaign.id)}\n                                        style={{ border: '1px solid #065f46', background: '#065f46', color: '#fff', borderRadius: '999px', padding: '6px 10px', fontSize: '11px', fontWeight: 900, cursor: 'pointer' }}\n                                      >\n                                        Simulate Send <span title="Simulate Send creates safe-mode sent_simulated events directly from the UI. It is used to test analytics, events, and funnel reporting. No email leaves the system." style={{ marginLeft: '6px', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: '14px', height: '14px', borderRadius: '999px', background: 'rgba(255,255,255,0.18)', fontSize: '10px', fontWeight: 900 }}>i</span>\n                                      </button>\n                                      <button\n                                        type="button"\n                                        onClick={() => runSignalSafeSend(campaign.id)}\n                                        style={{ border: '1px solid #111827', background: '#111827', color: '#fff', borderRadius: '999px', padding: '6px 10px', fontSize: '11px', fontWeight: 900, cursor: 'pointer' }}\n                                      >\n                                        {signalSendMode === 'live' ? 'Send Campaign (Live)' : 'Send Campaign (Safe)'} <span title="Send Campaign uses the backend send engine. In Safe Mode it prepares send payloads, checks suppressions, logs results, and updates telemetry. Live delivery remains blocked until readiness checks pass." style={{ marginLeft: '6px', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: '14px', height: '14px', borderRadius: '999px', background: 'rgba(255,255,255,0.18)', fontSize: '10px', fontWeight: 900 }}>i</span>\n                                      </button>\n<div style={{marginTop:'6px',color:'#647